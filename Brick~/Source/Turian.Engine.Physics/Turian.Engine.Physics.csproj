<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>1.0.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(TurianDir)Turian/Engine/Core/Turian.Engine.Core.csproj"/>
        <InternalsVisibleTo Include="Turian.Physics.Tests"/>
        <InternalsVisibleTo Include="Turian.Physics.Bepu.Tests"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="../../../Runtime/**/*.cs"/>
    </ItemGroup>
    <Target Name="PrecastRuntimeAssemblies" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BrickDir)Brick~/Precast/lib"/>
    </Target>
</Project>
